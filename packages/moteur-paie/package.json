{
  "name": "@paie/moteur",
  "version": "0.1.0",
  "description": "Moteur de calcul de paie isolé et testé — paramètres légaux chargés depuis parametres/AAAA.json",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
