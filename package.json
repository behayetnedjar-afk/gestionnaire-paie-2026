{
  "name": "gestionnaire-paie-2026",
  "private": true,
  "description": "Plateforme d'apprentissage de la paie — Référentiel 2026",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspace @paie/moteur",
    "build": "npm run build --workspace @paie/moteur",
    "build:site": "esbuild packages/moteur-paie/src/index.ts --bundle --format=iife --global-name=MoteurPaie --target=es2019 --outfile=site/assets/moteur.js",
    "dev": "npm run build:site && python -m http.server 8000"
  },
  "devDependencies": {
    "esbuild": "0.24.0"
  }
}
